# npm user config, stowed from ~/.dotfiles/npm. Holds no secrets.

# GitHub Packages (@esolia/*). ~/.envrc exports NODE_AUTH_TOKEN from the keys
# store (GH_PACKAGES_READ, read:packages only); repo .npmrc files use the same
# line, so CI and Workers Builds supply it the same way.
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# npm 12 runs no install scripts unless allowed. pnpm's swaps its shebang-less
# placeholder for the native binary; without it `keys run -- pnpm` fails with
# ENOEXEC. `up` checks for this after `npm update -g`.
allow-scripts=pnpm
