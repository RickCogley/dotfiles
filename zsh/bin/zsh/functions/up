# up — one-step housekeeping. Runs only the steps whose tools are present,
# so it degrades quietly on a fresh machine instead of erroring out.
#
#   up            run every available step
#   up brew       run one step (brew|mise|claude|deno|npm|pnpm|uv|rust|gh|zsh|keys|mac|qc|certs|db|tools|stale|docker|cache|vault|expiry)
#   up -n         dry run: list what would run
#
# Steps that need root (certs, db, qc's login banner) share one sudo prompt at
# the start of the run, and only when one of them has work to do (see _up_sudo).
#
# Replaces the old `allup`, which called z4h/mas/brew-cu/dein — none installed.

emulate -L zsh
setopt local_options no_unset
zmodload zsh/datetime   # EPOCHREALTIME: float clock, no fork per reading
# zstat only: a bare `zmodload zsh/stat` would shadow /usr/bin/stat, whose
# BSD flags _up_db relies on.
zmodload -F zsh/stat b:zstat

local -a steps requested
local s dry=0 failed=() ran=() todo=()
local -F t0=$EPOCHREALTIME
local -i sudo_keepalive=0
# Function-scoped in zsh: runs when `up` returns, also after a Ctrl-C.
trap '(( sudo_keepalive )) && kill $sudo_keepalive 2>/dev/null' EXIT

steps=(brew mise claude deno npm pnpm uv rust gh zsh keys mac qc certs db tools stale docker cache vault expiry)

# The login-window banner `up qc` keeps (a system domain, so sudo; mise's
# preference engine is user-only).
local qc_banner='Authorized Personnel Only - eSolia Inc.'

# The two roots the compromised eMudhra intermediates chain to (see _up_certs),
# as /etc/ssl/cert.pem labels them.
local -a cert_subjects=(
  '=== /C=IN/OU=emSign PKI/O=eMudhra Technologies Limited/CN=emSign ECC Root CA - G3'
  '=== /C=GB/ST=Greater Manchester/L=Salford/O=Comodo CA Limited/CN=AAA Certificate Services'
)

while (( $# )); do
  case "$1" in
    -n|--dry-run) dry=1 ;;
    -h|--help)    print -- "usage: up [-n] [${(j:|:)steps}]"; return 0 ;;
    *)            requested+=("$1") ;;
  esac
  shift
done
(( $#requested )) || requested=($steps)

_up_dur() {  # <seconds> → 3.2s | 42s | 1m05s | 1h02m
  local -i t=$1
  if   (( t < 10 ));   then printf '%.1fs' $1
  elif (( t < 60 ));   then print -n -- ${t}s
  elif (( t < 3600 )); then printf '%dm%02ds' $(( t / 60 )) $(( t % 60 ))
  else                      printf '%dh%02dm' $(( t / 3600 )) $(( t % 3600 / 60 ))
  fi
}

_up_head() { print -P "\n%F{4}%B━━━ $1 %f%b%F{8}%D{%H:%M:%S}%f"; }
# Notes trail the time elapsed in the current step (s0, set by _up_run), so a
# slow sub-command shows up as a jump between consecutive notes. Hidden under 1s.
_up_note() {
  local -F e=$(( EPOCHREALTIME - ${s0:-$EPOCHREALTIME} ))
  if (( e >= 1 )); then print -P "%F{5}→%f $1 %F{8}+$(_up_dur $e)%f"
  else                  print -P "%F{5}→%f $1"
  fi
}
_up_skip() { print -P "%F{8}·%f skip: $1"; }
# Something for the person to do: shown in the step, and again in the summary.
# A to-do's text can come from other programs (mise, keys), so it is printed
# raw: with promptsubst on, print -P would run any $(...) in it (#90).
_up_todo() { print -nP "%F{3}☐%f "; print -r -- "$1"; todo+=("$1"); }

_up_run() {  # _up_run <label> <required-cmd> <function>
  local label=$1 need=$2 fn=$3 took
  # znap and friends are shell functions, not binaries — check both tables.
  if ! (( $+commands[$need] || $+functions[$need] )); then
    _up_skip "$label ($need not installed)"; return
  fi
  if (( dry )); then print -P "%F{3}would run:%f $label"; return; fi
  _up_head "$label"
  local -F s0=$EPOCHREALTIME
  if $fn; then
    took="%F{8}$(_up_dur $(( EPOCHREALTIME - s0 )))%f"
    ran+=("$label $took"); print -P "%F{2}✓%f $label $took"
  else
    took="%F{8}$(_up_dur $(( EPOCHREALTIME - s0 )))%f"
    failed+=("$label $took"); print -P "%F{1}✗%f $label $took"
  fi
}

_up_brew() {
  # When `brew link` overwrites a file it did not put there (npm/npx after
  # `npm update -g` replaced node's own copies, pip after a pip self-upgrade),
  # it moves the old file into $(brew --cache)/Backup, and nothing ever prunes
  # that, not even `brew cleanup -s`. Clear the previous run's backups before
  # upgrading, so the newest set survives until the next run in case one is
  # needed back.
  local cache="$(brew --cache)" ; local -a old
  [[ -n $cache ]] && old=( $cache/Backup/*(DN) )
  if (( $#old )); then
    _up_note "clear previous link backups ($(du -sh $cache/Backup | cut -f1)) in $cache/Backup"
    rm -rf -- $old
  fi
  _up_note "update + upgrade formulae and casks"
  # --yes: Homebrew 6.0 asks for confirmation by default, which would stall an
  # unattended run. HOMEBREW_NO_ASK in .zshrc covers interactive use; this makes
  # the housekeeping path independent of the environment.
  brew update && brew upgrade --yes || return 1
  # openssh stays installed but unlinked: devkit release-keys.sh signs with
  # YubiKey (ed25519-sk) keys through the keg's ssh-keygen by full path, while
  # plain `ssh` must stay Apple's (Keychain, UseKeychain). An upgrade relinks
  # the keg and puts upstream ssh first on PATH, so undo that here.
  local brew_ssh="$(brew --prefix)/bin/ssh"
  if [[ -L $brew_ssh && $(readlink "$brew_ssh") == *Cellar/openssh/* ]]; then
    _up_note "unlink openssh (keg-only use for YubiKey release signing)"
    brew unlink openssh >/dev/null
  fi
  # Casks marked auto_updates are skipped by plain upgrade; surface the drift
  # rather than silently falling years behind (this is how wireshark-app rotted).
  local greedy
  greedy=$(brew outdated --cask --greedy --quiet 2>/dev/null)
  [[ -n $greedy ]] && { _up_note "auto-updating casks that have drifted:"; print -l -- ${(f)greedy} }
  # autoremove: formulae installed only as dependencies that nothing needs now.
  # --prune=all: plain `cleanup -s` keeps the downloads of installed versions
  # (4.9 GB on 2026-11-07); they are re-fetched on a reinstall, so drop them.
  _up_note "cleanup"
  brew autoremove
  brew cleanup -s --prune=all
  _up_note "doctor"
  brew doctor || true   # doctor exits non-zero on cosmetic warnings
  return 0
}

# mise: the Node versions repos pin in .node-version or .nvmrc (dotfiles#81).
# mise remembers each config it has read; only repos that pin something are
# visited (a bare package.json gets tracked too). In each, `upgrade` moves a
# range such as "24" to the newest 24.x and leaves an exact pin such as
# 24.14.1 alone; without --bump it never edits a repo's file, so --quiet hides
# mise's hint to run `upgrade --bump`. A newer major is listed once instead:
# moving to it is a repo change, made in that repo's PR. stdin is /dev/null so
# an untrusted mise.toml fails the step instead of stopping at a trust prompt.
# prune then removes versions no repo still uses.
_up_mise() {
  local link dir name rc=0 behind
  local -aU dirs majors
  for link in ~/.local/state/mise/tracked-configs/*(N@); do
    name=${link:A:t}
    case $name in
      .node-version|.nvmrc|.tool-versions|mise.toml|.mise.toml) ;;
      *) continue ;;
    esac
    dir=${link:A:h}
    [[ -d $dir && $dir != ${${:-$HOME/.config/mise}:A} ]] && dirs+=($dir)
  done
  for dir in $dirs; do
    if [[ $(mise -C $dir outdated --json </dev/null 2>/dev/null) != '{}' ]]; then
      _up_note "${dir/#$HOME/~}: newer release in its range"
      mise -C $dir upgrade --quiet </dev/null || rc=1
    fi
    if (( $+commands[jq] )); then
      behind=$(mise -C $dir outdated --bump --json </dev/null 2>/dev/null \
        | jq -r '.node | select(.) | "\(.current) → \(.bump)"')
      [[ -n $behind ]] && majors+=("${dir:t} $behind")
    fi
  done
  (( $#dirs )) && _up_note "${#dirs} repos on their pinned Node"
  (( $#majors )) && _up_note "%F{8}newer major (bump .node-version in the repo): ${(j:, :)majors}%f"
  # The global fnox pin moves only when bumped in the dotfiles config (#83).
  if (( $+commands[jq] )); then
    local -a fnox
    fnox=(${(f)"$(mise -C ~ outdated --bump --json </dev/null 2>/dev/null \
      | jq -r '.fnox | select(.) | .requested, .bump, (.release_url // "")')"})
    (( $#fnox >= 2 )) && _up_todo "fnox ${fnox[2]} is out (pinned ${fnox[1]})
    1. read ${fnox[3]:-its release notes}
    2. in ~/.dotfiles, set fnox = \"${fnox[2]}\" in mise/.config/mise/config.toml and open a PR
    3. after merging: mise install
    4. the Keychain shouldn't ask again; if it does, allow only after
       codesign -dv \"\$(mise which fnox)\" shows TeamIdentifier=4993Y37DX6"
  fi
  # mise 2026.11.0 asks before pruning, and nobody can answer here, so the
  # step says what goes and passes --yes (#92). The list prints raw (#90).
  _up_note "remove versions nothing uses"
  if (( $+commands[jq] )); then
    local -a prunable
    prunable=(${(f)"$(mise ls --prunable --json </dev/null 2>/dev/null \
      | jq -r 'to_entries[] | .key as $t | .value[] | "\($t) \(.version)"')"})
    (( $#prunable )) || return $rc
    print -r -- "  ${(j:, :)prunable}"
  fi
  mise prune --tools --yes --quiet </dev/null || rc=1
  return $rc
}

_up_claude() {
  _up_note "claude update"; claude update || return 1
  _up_claude_agents
}

# Plugin agents overridden in dotfiles (claude-agents, dotfiles#99/#101):
# report only. Exit 3 means a plugin update changed an agent whose copy we
# keep: shown and added to the to-do list, not a step failure. The copy is
# refreshed by hand (claude-agents diff, then refresh) and goes out as a PR,
# so the new upstream prompt gets a look before it is adopted.
_up_claude_agents() {
  (( $+functions[claude-agents] )) || return 0
  _up_note "plugin agent overrides (report only)"
  local out rc
  out=$(claude-agents check </dev/null); rc=$?
  [[ -n $out ]] && print -r -- "$out"
  case $rc in
    0) return 0 ;;
    3) _up_todo "plugin agent override(s) behind the installed plugin
    run: claude-agents diff, then claude-agents refresh, and PR the change"
       return 0 ;;
    *) return 1 ;;
  esac
}
_up_rust()   { _up_note "rustup update"; rustup update; }

# Deno version selection is deliberate on this machine and this step must not
# change it. esolia-llm-guard builds eSolia Redact with `deno desktop`, an
# unstable feature whose output layout still churns between canaries; its CI
# pins an exact canary commit and says to bump it on purpose, and a matching
# canary is kept at ~/.dvm/canary/deno.
#
# So: upgrade dvm itself, then report. Neither `deno upgrade` (overwrites
# ~/.dvm/bin/deno in place, desyncing dvm's metadata from the binary that
# actually runs) nor `dvm upgrade` (moves aliases to latest) belongs in an
# unattended housekeeping run.
# `dvm upgrade self` is not used either: in dvm 1.9.0 it fetches the install
# script and hands the whole text to bash as an argument instead of piping it,
# so it prints the script, dies with "File name too long", and still exits 0.
# The documented alternative is curl | sh, which does not belong in an
# unattended run. Upgrading dvm stays manual.
_up_deno() {
  _up_note "installed versions — bump deliberately, desktop build pins a canary"
  dvm list
  _up_note "active: $(deno --version 2>/dev/null | head -1)"
  _up_note "dvm $(dvm --version 2>/dev/null | awk '{print $2}') — upgrade manually if needed"
  return 0
}

# pnpm 11+ installs as a shebang-less placeholder that its install script
# swaps for a native binary. npm 12 runs no install scripts unless allowed,
# so without `allow-scripts=pnpm` in ~/.npmrc an update leaves the
# placeholder: shells still run it, but Node's spawn (`keys run -- pnpm`)
# fails with ENOEXEC. Fail the step so the summary shows it.
#
# npm's global folder belongs to the Node that runs it. Homebrew's Node owns
# these globals, but inside a pinned repo mise puts the repo's Node first
# (dotfiles#81), so the step runs in a subshell from home with mise off PATH.
_up_npm() (
  cd ~ || return 1
  path=(${path:#$HOME/.local/share/mise/*})
  _up_note "global packages"
  npm update -g || return 1
  local pnpm_bin="$(npm root -g)/pnpm/pnpm"
  if [[ -f $pnpm_bin && $(file -b "$pnpm_bin") != Mach-O* ]]; then
    _up_note "%F{1}pnpm is the placeholder, not the native binary%f"
    _up_note "fix: %F{3}npm install -g pnpm --allow-scripts=pnpm%f, and add allow-scripts=pnpm to ~/.npmrc"
    return 1
  fi
  return 0
)

# pnpm global tools (wrangler and cf live here). `update -g` bumps each global
# within its recorded semver range; a new major (e.g. wrangler 4 -> 5) is
# deliberate, so bump that by hand with `pnpm add -g wrangler@latest`.
#
# cf (Cloudflare's wrangler successor) is the exception: while it ships
# prereleases, pnpm records an exact pin ("1.0.0-beta.6", even when asked for
# a ^range), so plain `update -g` never moves it. `--latest cf` follows the
# dist-tag instead. pnpm's minimumReleaseAge cooldown still applies, so this
# lands on the newest beta that is at least a day old, not the newest beta.
# Revisit once cf is GA and pnpm records a normal ^range.
_up_pnpm() {
  _up_note "global packages"
  pnpm update -g || return 1
  if pnpm ls -g --depth 0 2>/dev/null | grep -q ' cf@'; then
    _up_note "cf (tracks latest dist-tag while in beta)"
    pnpm update -g --latest cf || return 1
    _up_note "$(cf --version 2>/dev/null | head -1)"
  fi
  return 0
}

# uv-managed CLI tools. No-op when none are installed, so it's safe to always run.
_up_uv() {
  _up_note "uv tools"
  uv tool upgrade --all
}

_up_gh() {
  _up_note "gh extensions"
  gh extension upgrade --all
}

_up_zsh() {
  _up_note "znap plugins"
  znap pull
}

# eSolia Keys: report only. Installing a release replaces the code that
# handles secrets and asks for an Allow click, so it stays a deliberate
# `keys upgrade`. --check verifies the newest signed keys-v* tag against the
# installed copy and exits 4 when an update is available.
_up_keys() {
  _up_note "eSolia Keys release check (report only)"
  keys upgrade --check
  case $? in
    0) return 0 ;;
    4) _up_note "update available: run %F{3}keys upgrade%f (asks you to click Allow)"; return 0 ;;
    *) return 1 ;;
  esac
}

# Vault keys (eSolia Keys 0.37.0+, eSolia/devkit#655): report only. One
# listing per vault through the vault login, never a value, never an Allow.
# Exit 3 means a copy is out of date, a key was removed or disabled in its
# vault, or a vault can't be read: shown and added to the to-do list, not a
# step failure. Keys before 0.37.0 refuse sync --check (exit 1), so the step
# skips quietly until keys' help lists it, instead of showing as failed.
_up_vault() {
  if ! keys help sync 2>/dev/null | grep -q -- 'sync --check'; then
    _up_note "keys has no sync --check yet (0.37.0 adds it); skipped"
    return 0
  fi
  _up_note "vault keys changed since your last sync (report only)"
  local out rc
  out=$(keys sync --check --json </dev/null); rc=$?
  case $rc in
    0) return 0 ;;
    3) _up_vault_todos "$out"; return 0 ;;
    *) return 1 ;;
  esac
}

_up_vault_todos() {  # <json from keys sync --check --json>
  local out=$1
  local -a changed gone unreadable
  changed=(${(f)"$(jq -r '.result.changed[]?' <<<"$out" 2>/dev/null)"})
  gone=(${(f)"$(jq -r '((.result.removed // []) + (.result.disabled // []))[]' <<<"$out" 2>/dev/null)"})
  unreadable=(${(f)"$(jq -r '.result.unreadable[]? | "\(.vault) (\(.keys | join(", ")))"' <<<"$out" 2>/dev/null)"})
  (( $#changed )) && _up_todo "$#changed secret(s) changed in their vault since your last sync
    (${(j:, :)changed})
    run: keys sync"
  (( $#gone )) && _up_todo "$#gone secret(s) removed or disabled in their vault: ${(j:, :)gone}
    ask the bundle's owner; keys sync --check says which"
  (( $#unreadable )) && _up_todo "can't read ${(j:; :)unreadable}
    keys sync --check says why"
  return 0
}

# Last on purpose: what needs doing soon. Store-wide (every GitHub and
# Cloudflare token in ~/.ssh/tokens), checked with each issuer; --soon prints
# only expiring, expired or rejected tokens, else a single "nothing expiring"
# line. Exit 3 means something needs attention — shown, not a step failure.
_up_expiry() {
  _up_note "tokens expiring soon (eSolia Keys)"
  keys expiry --soon
  case $? in
    0|3) return 0 ;;
    *)   return 1 ;;
  esac
}

_up_mac() {
  _up_note "pending macOS software updates (list only — install manually)"
  softwareupdate --list 2>&1 | sed '/^$/d'
  # What matters before installing one: room for the installer (it wants
  # 20-30 GB), local snapshots that may be holding space, and a backup that
  # is recent and reachable. Listing snapshots needs no sudo; thinning does.
  local free last
  local -a snaps
  free=$(df -h / | awk 'NR == 2 { print $4 }')
  snaps=( ${(f)"$(tmutil listlocalsnapshots / 2>/dev/null \
    | sed -n 's/^com\.apple\.TimeMachine\.\(.*\)\.local$/\1/p')"} )
  # Hourly snapshots are normal (24 a day); the oldest shows whether one is
  # stuck. latestbackup prints nothing, with exit 0, when the disk is away.
  _up_note "free space ${free}B; ${#snaps} local snapshot(s)${snaps:+, oldest ${snaps[1]%-*}}"
  last=$(tmutil latestbackup -t 2>/dev/null)
  if [[ -n $last ]]; then
    _up_note "last Time Machine backup: $last"
  else
    _up_note "%F{3}no Time Machine backup disk reachable%f — back up before installing"
  fi
  return 0
}

# macOS settings QC (dotfiles#113): the preferences this Mac should have, and
# the security posture it should keep, checked every run.
#   1. Preferences declared in ~/.config/mise/config.toml under
#      [bootstrap.macos.defaults] (dotfiles mise package). mise reports each
#      as set, differs or unset and writes only the drift, type included; it
#      never deletes. Finder and Dock are relaunched only when their domains
#      changed; NSGlobalDomain changes reach each app as it next launches.
#   2. The login-window banner: a system domain, so `up` writes it with sudo.
#   3. Posture, report only: anything off becomes a to-do with the fix, never
#      changed from here (FileVault, SIP and Gatekeeper are deliberate acts).
_up_qc_pending() {  # banner missing or different: sudo work this run
  [[ $(defaults read /Library/Preferences/com.apple.loginwindow LoginwindowText 2>/dev/null) != $qc_banner ]]
}

# _up_qc_check [-x] <label> <expected> <fix> -- <command...>
# A posture check: runs the command, passes when its output contains the
# expected text (with -x: is exactly that text, for a `defaults read` value),
# otherwise adds a to-do quoting what it said.
_up_qc_check() {
  local -i exact=0
  [[ $1 == -x ]] && { exact=1; shift }
  local label=$1 want=$2 fix=$3 out
  shift 4
  out=$("$@" 2>&1)
  if (( exact )) && [[ $out == "$want" ]] || (( ! exact )) && [[ $out == *"$want"* ]]; then
    qc_ok+=($label)
  else
    _up_todo "$label: ${out:-no output}"$'\n'"    fix: $fix"
  fi
}

_up_qc() {
  local json row state domain key current
  local -a rows drift domains
  local -a qc_ok
  if ! (( $+commands[mise] && $+commands[jq] )); then
    _up_note "needs mise and jq; skipped"; return 0
  fi
  _up_note "declared preferences (mise bootstrap macos defaults)"
  # From $HOME on purpose: run inside a repo, mise would also load that
  # repo's mise.toml (or stop at its trust prompt).
  json=$(mise -C ~ bootstrap macos defaults status --json </dev/null 2>&1) || {
    _up_note "mise could not report preference state:"; print -r -- "$json"; return 1
  }
  rows=( ${(f)"$(jq -r '.macos_defaults.entries[] | [.state, .domain, .key, .current] | @tsv' <<<"$json")"} )
  for row in $rows; do
    IFS=$'\t' read -r state domain key current <<<"$row"
    [[ $state == set ]] && continue
    drift+=("$domain $key: $state${current:+ (now $current)}")
    domains+=($domain)
  done
  if (( $#drift )); then
    print -rl -- ${drift/#/  }
    _up_note "writing $#drift of $#rows"
    mise -C ~ bootstrap macos defaults apply --yes </dev/null || return 1
    if (( ${domains[(Ie)com.apple.finder]} || ${domains[(Ie)com.apple.desktopservices]} )); then
      _up_note "relaunching Finder"; killall Finder 2>/dev/null
    fi
    if (( ${domains[(Ie)com.apple.dock]} )); then
      _up_note "relaunching Dock"; killall Dock 2>/dev/null
    fi
    (( ${domains[(Ie)NSGlobalDomain]} )) && _up_note "NSGlobalDomain changes apply to each app as it next launches"
  else
    _up_note "all $#rows declared preferences set"
  fi
  if _up_qc_pending; then
    _up_note "login window banner (needs sudo)"
    sudo defaults write /Library/Preferences/com.apple.loginwindow LoginwindowText -string "$qc_banner" || return 1
  fi
  _up_qc_check FileVault   'FileVault is On'      'System Settings > Privacy & Security > FileVault' -- fdesetup status
  # "status: enabled" exactly: a custom configuration prints "unknown" and
  # then per-feature lines that also say enabled.
  _up_qc_check SIP         'status: enabled'      'boot to Recovery, then: csrutil enable' -- csrutil status
  _up_qc_check Gatekeeper  'assessments enabled'  'System Settings > Privacy & Security > Allow applications from' -- spctl --status
  _up_qc_check Firewall    'enabled'              'sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on' \
    -- /usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate
  _up_qc_check 'Firewall stealth' 'stealth mode is on' 'sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on' \
    -- /usr/libexec/ApplicationFirewall/socketfilterfw --getstealthmode
  _up_qc_check 'Screen lock' 'immediate' 'System Settings > Lock Screen > Require password: Immediately' \
    -- sysadminctl -screenLock status
  local key
  for key in AutomaticDownload CriticalUpdateInstall ConfigDataInstall AutomaticallyInstallMacOSUpdates; do
    _up_qc_check -x "Auto-update $key" 1 'System Settings > General > Software Update > Automatic Updates' \
      -- defaults read /Library/Preferences/com.apple.SoftwareUpdate $key
  done
  _up_qc_check -x 'App Store auto-update' 1 'System Settings > General > Software Update > Automatic Updates' \
    -- defaults read /Library/Preferences/com.apple.commerce AutoUpdate
  # Services that should stay off: loaded means on.
  local svc
  for svc in com.apple.screensharing:'Screen Sharing' com.openssh.sshd:'Remote Login'; do
    if launchctl print system/${svc%%:*} >/dev/null 2>&1; then
      _up_todo "${svc#*:} is on"$'\n'"    fix: System Settings > General > Sharing"
    else qc_ok+=("${svc#*:} off"); fi
  done
  _up_note "posture ok: ${(j:, :)qc_ok}"
  return 0
}

# Compromised eMudhra intermediate CAs (Apple support 149555, 2026-10-19).
# Apple blocks the 12 certificates automatically in Safari, Mail and apps on
# its frameworks, but curl, git, python3, ruby, perl and openssl trust
# /etc/ssl/cert.pem and never consult that block or revocation. Until a macOS
# update fixes the file, follow Apple's steps and remove the two roots the
# compromised intermediates chain to:
#   emSign ECC Root CA - G3   the 6 issued under emSign Root TLS CA - G3
#   AAA Certificate Services  the 6 Sectigo cross-signs
# Removing AAA also stops cert.pem-only tools verifying other old Comodo
# chains through it; Apple calls that step optional, taken here on purpose.
#
# Lives in `up` because a macOS update can put the file back: each run
# re-checks and asks for sudo only when a root has returned. Once Apple's
# update ships the roots stay gone, this reports so, and the step can go.
_up_certs_pending() {  # true while either root is back in cert.pem
  local s
  for s in $cert_subjects; do grep -qxF -- "$s" /etc/ssl/cert.pem && return 0; done
  return 1
}

_up_certs() {
  local pem=/etc/ssl/cert.pem s t rc
  local -a subjects present
  subjects=($cert_subjects)
  for s in $subjects; do grep -qxF -- "$s" $pem && present+=("$s"); done
  if (( ! $#present )); then _up_note "eMudhra-chained roots already absent from $pem"; return 0; fi
  # Both present means this is Apple's file (first run, or an update replaced
  # it), so the backup is refreshed to match, as Apple's steps direct.
  if (( $#present == $#subjects )) || [[ ! -e $pem.orig ]]; then
    _up_note "backing up $pem to $pem.orig (needs sudo)"
    sudo cp -p $pem $pem.orig || return 1
  fi
  for s in $present; do
    _up_note "removing ${s##*CN=} (needs sudo)"
    t=$(mktemp) || return 1
    awk -v s="$s" '/^(===|###) /{skip=0} $0==s{skip=1} !skip' $pem > "$t" \
      && [[ -s $t ]] && sudo install -m 0644 -o root -g wheel "$t" $pem
    rc=$?
    rm -f "$t"
    (( rc )) && return 1
  done
  # Apple's check: no output means both roots are gone.
  if openssl crl2pkcs7 -nocrl -certfile $pem | openssl pkcs7 -print_certs -noout \
       | grep -E 'emSign ECC Root CA - G3|AAA Certificate Services'; then
    _up_note "still present; restore with: sudo cp -p $pem.orig $pem"; return 1
  fi
  _up_note "verified: neither root left in $pem"
}

# Dev servers nobody is attached to. Closing a terminal tab ends `wrangler dev`
# or `vite dev` but can leave its workerd child running, reparented to launchd.
# By 2026-10-31, 109 had piled up (the oldest 60 days) while the Mac was deep
# in swap. Stopped only when all of these hold, so a server in an open
# terminal is never touched:
#   - mine, and its parent is launchd (pid 1): no shell owns it any more
#   - running for 12 hours or more
#   - its command matches a known dev server or test watcher
# Old ones still attached to a terminal are listed, not stopped.
_up_stale() {
  local -a patterns rows pids keep summary
  local -A by_project
  local line pid ppid etime cmd p project
  local -i hours
  # A space before "dev": every path under ~/dev contains "dev" too.
  patterns=('*workerd serve*' '*wrangler* dev*' '*/vite/bin/vite.js*' '*/vitest/*'
            '*astro* dev*' '*esbuild --service*')
  rows=( ${(f)"$(ps -U $USER -o pid=,ppid=,etime=,command=)"} )
  for line in $rows; do
    read -r pid ppid etime cmd <<< "$line"
    for p in $patterns; do [[ $cmd == ${~p} ]] && break; p=; done
    [[ -n $p ]] || continue
    # etime is [[DD-]HH:]MM:SS; count whole hours.
    if [[ $etime == *-* ]]; then hours=$(( 10#${etime%%-*} * 24 ))
    elif [[ $etime == *:*:* ]]; then hours=$(( 10#${etime%%:*} ))
    else hours=0; fi
    project=${${cmd%%/node_modules/*}##* }; project=${project:t}
    if (( ppid == 1 && hours >= 12 )); then
      pids+=($pid); (( by_project[$project]++ ))
    elif (( ppid != 1 && hours >= 24 * 7 )); then
      keep+=("$project ($(( hours / 24 ))d, pid $pid)")
    fi
  done
  if (( $#pids )); then
    for project in ${(k)by_project}; do summary+=("$by_project[$project] $project"); done
    _up_note "stopping $#pids orphaned dev server(s): ${(j:, :)summary}"
    kill -TERM $pids 2>/dev/null
    sleep 3
    pids=( ${(f)"$(ps -o pid= -p ${(j:,:)pids} 2>/dev/null)"} )
    pids=( ${pids// /} ); pids=( ${pids:#} )
    if (( $#pids )); then
      _up_note "$#pids still running after TERM; sending KILL"
      kill -KILL $pids 2>/dev/null
    fi
  else
    _up_note "no orphaned dev servers"
  fi
  (( $#keep )) && _up_note "still attached to a terminal, a week or older (left running): ${(j:, :)keep}"
  return 0
}

# Docker leftovers (dotfiles#107). Builds leave three kinds of waste that
# nothing else removes; on 2026-11-07 they came to 9.67 GB of images and
# 3.65 GB of build cache:
#   - dangling images: the previous build of a tag that was built again
#     (typst-pdf:local-test and friends). Untagged, so nothing can use them.
#   - build cache: kept here for 7 days, so a rebuild this week stays fast.
#   - old releases of images pushed to Cloudflare's container registry
#     (typst-pdf, git-backup), each held twice: name:vX.Y.Z and its
#     registry.cloudflare.com/<account>/name:vX.Y.Z tag. The registry keeps
#     every version; locally the newest 2 per image stay for re-testing.
# Tool images (pandoc, actionlint, veraPDF) and anything not pushed to the
# Cloudflare registry are left alone. Skipped when OrbStack isn't running, so
# `up` never starts it just to clean it.
_up_docker() {
  if (( $+commands[orbctl] )) && [[ $(orbctl status 2>/dev/null) != Running ]]; then
    _up_note "OrbStack not running; skipped"; return 0
  fi
  docker info >/dev/null 2>&1 || { _up_note "Docker engine not reachable; skipped"; return 0; }

  local -i keep=2
  local repo tag id name line
  local -a rows old
  local -A seen kept
  # `docker images` lists newest first, so the first IDs seen per image are kept.
  rows=( ${(f)"$(docker images --format '{{.Repository}} {{.Tag}} {{.ID}}')"} )
  for line in $rows; do
    read -r repo tag id <<< "$line"
    [[ $repo == registry.cloudflare.com/*/* && $tag == v[0-9]* ]] || continue
    name=${repo:t}
    if [[ -z ${seen[$name:$id]-} ]]; then
      seen[$name:$id]=1
      (( kept[$name]++ ))
    fi
    (( ${kept[$name]:-0} > keep )) || continue
    old+=("$repo:$tag")
    docker image inspect "$name:$tag" >/dev/null 2>&1 && old+=("$name:$tag")
  done
  if (( $#old )); then
    _up_note "untag $#old old Cloudflare release tag(s), keeping the newest $keep per image (all stay in the registry)"
    docker rmi $old >/dev/null || return 1
  else
    _up_note "no old Cloudflare release images"
  fi
  _up_note "dangling images"
  docker image prune -f | tail -1
  _up_note "build cache older than 7 days"
  docker builder prune -f --filter until=168h | tail -1
  _up_note "$(docker system df --format '{{.Type}}: {{.Size}}' | paste -sd ' ' - | sed 's/  */ /g')"
  return 0
}

# Caches that tools fill and never empty (dotfiles#109). On 2026-11-07: npm
# 15 GB, uv 6.7 GB, puppeteer 5.9 GB (11 Chrome builds back to 131),
# playwright-mcp 3 GB (25 mcp-chrome builds), node-gyp 1.4 GB (24 header sets
# for 3 installed Nodes), ~/Library/Logs 1 GB. What goes is re-fetched on
# demand, except old browser builds, which get a 90-day grace and a recovery
# hint; nothing needs sudo; Trash and Downloads are user data, measured and
# left alone (du on both takes ~10 s, worth it before a macOS update).
_up_cache() {
  local d f out rc
  local -a all old sz
  local -aU keep
  local -i bytes i
  if (( $+commands[npm] )); then
    _up_note "npm cache: verify and garbage-collect"
    npm cache verify </dev/null || return 1
  fi
  # A uvx-served tool holds the cache lock; UV_LOCK_TIMEOUT (uv 0.9.16+)
  # bounds the wait, and the prune is skipped this run instead of hanging.
  if (( $+commands[uv] )); then
    _up_note "uv cache: prune unreachable objects"
    out=$(UV_LOCK_TIMEOUT=15 uv cache prune 2>&1); rc=$?
    print -r -- "$out"
    if (( rc )); then
      if [[ $out == *(waiting for lock|another uv process|acquire lock)* ]]; then
        _up_note "uv cache in use; prune skipped this run"
      else
        return 1
      fi
    fi
  fi
  # Browser builds. Each puppeteer version pins one Chrome, fetched at `npm
  # install` and never again, and each playwright-mcp release pins one
  # mcp-chrome build by hash, so a build in use can't be told from a dead one
  # by its files (access times aren't dependable here). Rule: the newest per
  # directory stays, and so does anything downloaded in the last 90 days;
  # the rest goes. A project pinned to an older puppeteer gets it back with
  # `npx puppeteer browsers install chrome`; playwright-mcp re-fetches its own.
  for d in ~/.cache/puppeteer/chrome ~/.cache/puppeteer/chrome-headless-shell \
           ~/Library/Caches/ms-playwright ~/Library/Caches/ms-playwright-mcp; do
    [[ $d == */puppeteer/* ]] && all=( $d/*(N/om) ) || all=( $d/mcp-chrome-*(N/om) )
    (( $#all > 1 )) || continue
    old=()
    for f in $all[2,-1]; do   # all but the newest, downloaded over 90 days ago
      zstat -A sz +mtime -- $f 2>/dev/null && (( EPOCHSECONDS - sz[1] > 90 * 86400 )) && old+=($f)
    done
    (( $#old )) || continue
    _up_note "${d:h:t}/${d:t}: remove $#old build(s) older than 90 days, keep ${all[1]:t}"
    rm -rf -- $old
  done
  # node-gyp caches a header set per Node version it built against; keep the
  # ones for Nodes still installed: mise's, Homebrew's, and whichever is on
  # PATH here (inside a pinned repo that is the repo's).
  if [[ -d ~/Library/Caches/node-gyp ]]; then
    keep=()
    (( $+commands[mise] && $+commands[jq] )) \
      && keep+=( ${(f)"$(mise ls node --json 2>/dev/null | jq -r '.[].version')"} )
    (( $+commands[brew] )) && [[ -x $(brew --prefix)/bin/node ]] \
      && keep+=( ${$($(brew --prefix)/bin/node --version 2>/dev/null)#v} )
    (( $+commands[node] )) && keep+=( ${$(node --version 2>/dev/null)#v} )
    keep=( ${keep:#} )
    old=()
    for d in ~/Library/Caches/node-gyp/*(N/); do
      (( ${keep[(Ie)${d:t}]} )) || old+=($d)
    done
    if (( $#keep && $#old )); then
      _up_note "node-gyp: remove headers for $#old Node version(s) no longer installed (keeping ${(j:, :)keep})"
      rm -rf -- $old
    fi
  fi
  # Log files older than 30 days. Apps keep writing to the newest file; a
  # deleted open file just vanishes when it is closed.
  all=( ~/Library/Logs/**/*(.N^mh-720) )
  if (( $#all )); then
    bytes=0
    for f in $all; do zstat -A sz +size -- $f 2>/dev/null && (( bytes += sz[1] )); done
    _up_note "logs: remove $#all file(s) older than 30 days ($(( bytes / 1048576 )) MB)"
    # In batches: a year of Homebrew and simulator logs can pass ARG_MAX.
    for (( i = 1; i <= $#all; i += 500 )); do rm -f -- $all[i,i+499]; done
  fi
  _up_note "left alone: Trash $(du -sh ~/.Trash 2>/dev/null | awk '{ print $1 }'), Downloads $(du -sh ~/Downloads 2>/dev/null | awk '{ print $1 }')"
  return 0
}

# Informational, not an update: reminds me what modern CLI tools are installed
# (see the `tools` function — single source of truth). Always "succeeds".
_up_tools() { tools; }

_up_db_pending() {  # Wednesdays, and not yet rebuilt today (the db's own mtime)
  [[ $(date +%u) == 3 ]] || return 1
  ! [[ -f /var/db/locate.database \
       && $(stat -f %Sm -t %F /var/db/locate.database) == $(date +%F) ]]
}

_up_db() {
  # Weekly only: locate db needs sudo, don't prompt on every run.
  if [[ $(date +%u) != 3 ]]; then _up_skip "locate db (Wednesdays only)"; return 0; fi
  # Already rebuilt today? Skip, so a second `up` in one day doesn't re-prompt
  # for sudo and redo the work.
  if ! _up_db_pending; then _up_skip "locate db (already rebuilt today)"; return 0; fi
  _up_note "refreshing locate database (needs sudo)"
  # macOS's locate.updatedb drops privs via `su -fm nobody`, which is broken on
  # this machine (triggers a password-change prompt -> "su: Sorry"). Replicate its
  # intent with `sudo -u nobody`: build the codes file as nobody, install as root.
  # Run from / because nobody cannot getcwd() inside $HOME.
  local fcodes rc
  fcodes=$(cd / && sudo -u nobody mktemp -t updatedb) || return 1
  ( cd / && sudo -u nobody env FCODES="$fcodes" SEARCHPATHS=/ /usr/libexec/locate.updatedb ) \
    && sudo install -m 0444 -o nobody -g wheel "$fcodes" /var/db/locate.database
  rc=$?
  sudo rm -f "$fcodes"
  return $rc
}

# One sudo prompt per run (dotfiles#109). Asks only when a requested step has
# root work to do this run: certs when a root is back in cert.pem, db on its
# day. sudo's ticket lasts 5 minutes per terminal and a brew upgrade outlasts
# it, so a background loop refreshes the ticket until `up` returns (the EXIT
# trap above ends it, after a Ctrl-C too) and gives up after 2 hours anyway.
# InfoSec: extends the sudo timestamp only for this run and this terminal;
# nothing is written to sudoers. With pam_tid the prompt is a Touch ID dialog.
_up_sudo() {
  local s
  local -a why
  (( dry )) && return 0
  for s in $requested; do
    case $s in
      certs) (( $+commands[openssl] )) && _up_certs_pending && why+=(certs) ;;
      db)    (( $+commands[sudo] )) && _up_db_pending && why+=(db) ;;
      qc)    (( $+commands[defaults] && $+commands[mise] )) && _up_qc_pending && why+=(qc) ;;
    esac
  done
  (( $#why )) || return 0
  if ! sudo -n true 2>/dev/null; then
    print -P "%F{5}→%f sudo needed by ${(j:, :)why}; asking once"
    sudo -v || return 1
  fi
  # Detached from the terminal: otherwise its `sleep` would hold a pipe such
  # as `up | tee` open for up to a minute after the run. The sleep runs as a
  # job so the TERM from the EXIT trap takes it down too, not just the loop.
  ( local -i i; local nap
    trap 'kill ${nap:-} 2>/dev/null; exit' TERM
    for (( i = 0; i < 120; i++ )); do
      kill -0 $$ 2>/dev/null || exit
      sudo -n -v 2>/dev/null
      sleep 60 & nap=$!; wait $nap
    done ) </dev/null >/dev/null 2>&1 &!
  sudo_keepalive=$!
  return 0
}

_up_sudo || print -P "%F{3}sudo not granted; steps that need it will ask%f"

for s in $requested; do
  case $s in
    brew)   _up_run "Homebrew"        brew    _up_brew   ;;
    mise)   _up_run "mise (Node per repo)" mise _up_mise ;;
    claude) _up_run "Claude Code"     claude  _up_claude ;;
    deno)   _up_run "Deno (via dvm)"  dvm     _up_deno   ;;
    npm)    _up_run "npm globals"     npm     _up_npm    ;;
    pnpm)   _up_run "pnpm globals"    pnpm    _up_pnpm   ;;
    uv)     _up_run "uv tools"        uv      _up_uv     ;;
    rust)   _up_run "Rust"            rustup  _up_rust   ;;
    gh)     _up_run "gh extensions"   gh      _up_gh     ;;
    zsh)    _up_run "zsh plugins"     znap    _up_zsh    ;;
    keys)   _up_run "eSolia Keys"     keys    _up_keys   ;;
    mac)    _up_run "macOS updates"   softwareupdate _up_mac ;;
    qc)     _up_run "macOS settings QC" defaults _up_qc  ;;   # Mac-only; mise and jq checked inside
    certs)  _up_run "eMudhra roots"   openssl _up_certs  ;;
    db)     _up_run "locate database" sudo    _up_db     ;;
    tools)  _up_run "Modern CLI tools" tools  _up_tools  ;;
    stale)  _up_run "Stale dev servers" ps    _up_stale  ;;
    docker) _up_run "Docker leftovers" docker _up_docker ;;
    cache)  _up_run "Tool caches"     du      _up_cache  ;;
    vault)  _up_run "Vault keys"      keys    _up_vault  ;;
    expiry) _up_run "Token expiry"    keys    _up_expiry ;;
    *)      print -u2 "up: unknown step '$s' (valid: ${(j:, :)steps})" ;;
  esac
done

(( dry )) && return 0

print -P "\n%F{4}%B━━━ summary %f%b"
(( $#ran ))    && print -P "%F{2}✓%f ${(j:, :)ran}"
(( $#failed )) && print -P "%F{1}✗ failed:%f ${(j:, :)failed}"
for s in $todo; do print -nP "%F{3}☐ to do:%f "; print -r -- "$s"; done
print -P "%F{8}⏱%f $(_up_dur $(( EPOCHREALTIME - t0 ))) total %F{8}· finished%f %D{%H:%M:%S}"
(( $#failed )) && return 1
return 0
