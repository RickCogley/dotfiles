# up — one-step housekeeping. Runs only the steps whose tools are present,
# so it degrades quietly on a fresh machine instead of erroring out.
#
#   up            run every available step
#   up brew       run one step (brew|claude|deno|npm|rust|gh|zsh|mac|db)
#   up -n         dry run: list what would run
#
# Replaces the old `allup`, which called z4h/mas/brew-cu/dein — none installed.

emulate -L zsh
setopt local_options no_unset

local -a steps requested
local dry=0 failed=() ran=()

steps=(brew claude deno npm rust gh zsh mac db)

while (( $# )); do
  case "$1" in
    -n|--dry-run) dry=1 ;;
    -h|--help)    print -- "usage: up [-n] [${(j:|:)steps}]"; return 0 ;;
    *)            requested+=("$1") ;;
  esac
  shift
done
(( $#requested )) || requested=($steps)

_up_head() { print -P "\n%F{4}%B━━━ $1 %f%b"; }
_up_note() { print -P "%F{5}→%f $1"; }
_up_skip() { print -P "%F{8}·%f skip: $1"; }

_up_run() {  # _up_run <label> <required-cmd> <function>
  local label=$1 need=$2 fn=$3
  # znap and friends are shell functions, not binaries — check both tables.
  if ! (( $+commands[$need] || $+functions[$need] )); then
    _up_skip "$label ($need not installed)"; return
  fi
  if (( dry )); then print -P "%F{3}would run:%f $label"; return; fi
  _up_head "$label"
  if $fn; then ran+=("$label"); else failed+=("$label"); fi
}

_up_brew() {
  _up_note "update + upgrade formulae and casks"
  # --yes: Homebrew 6.0 asks for confirmation by default, which would stall an
  # unattended run. HOMEBREW_NO_ASK in .zshrc covers interactive use; this makes
  # the housekeeping path independent of the environment.
  brew update && brew upgrade --yes || return 1
  # Casks marked auto_updates are skipped by plain upgrade; surface the drift
  # rather than silently falling years behind (this is how wireshark-app rotted).
  local greedy
  greedy=$(brew outdated --cask --greedy --quiet 2>/dev/null)
  [[ -n $greedy ]] && { _up_note "auto-updating casks that have drifted:"; print -l -- ${(f)greedy} }
  _up_note "cleanup"
  brew cleanup -s
  _up_note "doctor"
  brew doctor || true   # doctor exits non-zero on cosmetic warnings
  return 0
}

_up_claude() { _up_note "claude update"; claude update; }
_up_rust()   { _up_note "rustup update"; rustup update; }

# Deno version selection is deliberate on this machine and this step must not
# change it. esolia-llm-guard builds eSolia Redact with `deno desktop`, an
# unstable feature whose output layout still churns between canaries; its CI
# pins an exact canary commit and says to bump it on purpose, and a matching
# canary is kept at ~/.dvm/canary/deno.
#
# So: upgrade dvm itself, then report. Neither `deno upgrade` (overwrites
# ~/.dvm/bin/deno in place, desyncing dvm's metadata from the binary that
# actually runs) nor `dvm upgrade` (moves aliases to latest) belongs in an
# unattended housekeeping run.
# `dvm upgrade self` is not used either: in dvm 1.9.0 it fetches the install
# script and hands the whole text to bash as an argument instead of piping it,
# so it prints the script, dies with "File name too long", and still exits 0.
# The documented alternative is curl | sh, which does not belong in an
# unattended run. Upgrading dvm stays manual.
_up_deno() {
  _up_note "installed versions — bump deliberately, desktop build pins a canary"
  dvm list
  _up_note "active: $(deno --version 2>/dev/null | head -1)"
  _up_note "dvm $(dvm --version 2>/dev/null | awk '{print $2}') — upgrade manually if needed"
  return 0
}

_up_npm() {
  _up_note "global packages"
  npm update -g
}

_up_gh() {
  _up_note "gh extensions"
  gh extension upgrade --all
}

_up_zsh() {
  _up_note "znap plugins"
  znap pull
}

_up_mac() {
  _up_note "pending macOS software updates (list only — install manually)"
  softwareupdate --list 2>&1 | sed '/^$/d'
  return 0
}

_up_db() {
  # Weekly only: locate db needs sudo, don't prompt on every run.
  if [[ $(date +%u) != 3 ]]; then _up_skip "locate db (Wednesdays only)"; return 0; fi
  _up_note "refreshing locate database (needs sudo)"
  sudo /usr/libexec/locate.updatedb
}

for s in $requested; do
  case $s in
    brew)   _up_run "Homebrew"        brew    _up_brew   ;;
    claude) _up_run "Claude Code"     claude  _up_claude ;;
    deno)   _up_run "Deno (via dvm)"  dvm     _up_deno   ;;
    npm)    _up_run "npm globals"     npm     _up_npm    ;;
    rust)   _up_run "Rust"            rustup  _up_rust   ;;
    gh)     _up_run "gh extensions"   gh      _up_gh     ;;
    zsh)    _up_run "zsh plugins"     znap    _up_zsh    ;;
    mac)    _up_run "macOS updates"   softwareupdate _up_mac ;;
    db)     _up_run "locate database" sudo    _up_db     ;;
    *)      print -u2 "up: unknown step '$s' (valid: ${(j:, :)steps})" ;;
  esac
done

(( dry )) && return 0

print -P "\n%F{4}%B━━━ summary %f%b"
(( $#ran ))    && print -P "%F{2}✓%f ${(j:, :)ran}"
(( $#failed )) && { print -P "%F{1}✗ failed:%f ${(j:, :)failed}"; return 1 }
return 0
