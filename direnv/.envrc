# GitHub: a narrow classic token (scope: read:packages only) for GitHub Packages
# (.npmrc NODE_AUTH_TOKEN) and Homebrew. GITHUB_TOKEN is deliberately NOT exported:
# gh uses its own Keychain login, and the old admin-scoped PAT must not sit in every
# shell (secrets plan phase 0, 2026-10-04).
if [[ -f ~/.ssh/tokens/GH_PACKAGES_READ ]]; then
  export NODE_AUTH_TOKEN="$(cat ~/.ssh/tokens/GH_PACKAGES_READ)"
  export HOMEBREW_GITHUB_API_TOKEN="$NODE_AUTH_TOKEN"
fi

# eSolia account token; store key per the keys catalog pattern CLOUDFLARE_API_TOKEN_{ACCOUNT}
[[ -f ~/.ssh/tokens/CLOUDFLARE_API_TOKEN_ESOLIA ]] && export CLOUDFLARE_API_TOKEN="$(cat ~/.ssh/tokens/CLOUDFLARE_API_TOKEN_ESOLIA)"
[[ -f ~/.ssh/tokens/CLOUDFLARE_ACCOUNT_ID_ESOLIA ]] && export CLOUDFLARE_ACCOUNT_ID="$(cat ~/.ssh/tokens/CLOUDFLARE_ACCOUNT_ID_ESOLIA)"

# Azure: ESOLIA (own) subscription default; overridden per client project
[[ -f ~/.ssh/tokens/AZURE_SUBSCRIPTION_ID_ESOLIA ]] && export AZURE_SUBSCRIPTION_ID=$(cat ~/.ssh/tokens/AZURE_SUBSCRIPTION_ID_ESOLIA)

# Azure: ESOLIA (own) tenant default; overridden per client project
[[ -f ~/.ssh/tokens/AZURE_TENANT_ID_ESOLIA ]] && export AZURE_TENANT_ID=$(cat ~/.ssh/tokens/AZURE_TENANT_ID_ESOLIA)
