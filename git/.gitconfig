[include]
	path = ~/.gitconfig.local
[user]
	name = James R. Cogley
	email = rick.cogley@esolia.co.jp
[core]
	autocrlf = input
	safecrlf = true
	# No core.editor: git falls back to $EDITOR, which .zshrc sets to vim. Commit
	# messages stay in the terminal instead of opening a GUI editor.
	excludesfile = ~/.gitignore_global
	whitespace = trailing-space,space-before-tab
	# delta, not bat: bat highlights the diff as if it were source text, so +/-
	# markers and hunk headers get no special treatment. delta parses the diff.
	pager = delta
	hooksPath = ~/.githooks
[alias]
  co = checkout
  ci = commit
  st = status
  br = branch
  hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
  type = cat-file -t
  dump = cat-file -p
  # Structural diff via difftastic — compares syntax trees rather than lines, so
  # reindents and moved blocks stop showing up as changes. Opt-in per invocation;
  # plain `git diff` still goes through delta.
  dft = -c diff.external=difft diff
[interactive]
    # Without this, `git add -p` bypasses core.pager and loses delta entirely.
    diffFilter = delta --color-only
[delta]
    # Auto-detects light vs dark from the terminal, matching the Ghostty theme
    # pair rather than pinning one.
    navigate = true
    line-numbers = true
    hyperlinks = true
[diff]
    tool = zed
    colorMoved = default
[difftool "zed"]
    cmd = zed-preview --wait --diff $LOCAL $REMOTE
[merge]
  # Stays on code: Zed has no three-way merge CLI (only --diff, which takes two
  # paths), and the code binary is present via the code-cli cask.
  tool = code
[mergetool "code"]
  cmd = code --wait --new-window --merge $REMOTE $LOCAL $BASE $MERGED
[push]
	default = tracking
[pull]
	rebase = true
[filter "media"]
	required = true
	clean = git media clean %f
	smudge = git media smudge %f
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	required = true
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
[color]
	ui = auto
[branch]
	autosetupmerge = true
[rerere]
	enabled = true
[github]
	user = rickcogley
[ghi]
	token = !security find-internet-password -a rickcogley -s github.com -l 'ghi token' -w
[credential]
	helper = osxkeychain
[gpg]
	format = ssh
[commit]
	gpgsign = true
	template = ~/.gitmessage
[url "https://"]
	insteadOf = git://
[sendemail]
	smtpEncryption = tls
	smtpServer = smtp.gmail.com
	smtpUser = rick.cogley@esolia.co.jp
	smtpServerPort = 587
	multiEdit = true
[gc]
	autoDetach = false
[tag]
	forceSignAnnotated = true
	gpgsign = true
[init]
	defaultBranch = main
